# Variables the e2e stack (compose.yml, seed.sh) reads. Do not fill this in by
# hand: `bash web/e2e/ci/make-env.sh` writes web/e2e/ci/.env (git-ignored) with
# fresh random values. Names only here, never values.
API_IMAGE=
WEB_IMAGE=
ADMIN_IMAGE=
E2E_API_PORT=
E2E_WEB_PORT=
E2E_DB_PASSWORD=
E2E_REDIS_PASSWORD=
E2E_DATABASE_URL=
E2E_OWNER_PASSWORD=
AUTH_JWT_SECRET=
APP_ENCRYPTION_KEY=
CSRF_SECRET=
