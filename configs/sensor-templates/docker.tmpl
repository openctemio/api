{{- $slug := slugify .Sensor.Name -}}
# OpenCTEM sensor "{{$slug}}": docker run
# Generated by OpenCTEM at {{.GeneratedAt}}. Run it on the host that should scan.
# Edit configs/sensor-templates/docker.tmpl on the API host to change it.
{{- if not .APIKey}}
#
# The command reads the sensor's API key from OPENCTEM_API_KEY. The key is
# shown once, when the sensor is created or its key is rotated:
#   export OPENCTEM_API_KEY='rda_...'
{{- end}}
{{- if .CACert}}

# 1. Trust the platform's certificate authority (it uses a private CA).
sudo mkdir -p /etc/openctem/certs
sudo tee /etc/openctem/certs/openctem-root-ca.crt >/dev/null <<'OPENCTEM_CA'
{{.CACert}}OPENCTEM_CA
sudo chmod 0644 /etc/openctem/certs/openctem-root-ca.crt
{{- end}}
{{- if isDaemon .Sensor}}

# {{if .CACert}}2. {{end}}Start the sensor. It connects out to the platform (no inbound port)
# and runs the scans the platform dispatches. Results that cannot be delivered
# yet wait in the {{$slug}}-outbox volume, so a restart or an outage loses nothing.
docker run -d --name {{$slug}} --restart unless-stopped \
  -e API_URL={{shellQuote .BaseURL}} \
{{- if .APIKey}}
  -e API_KEY={{shellQuote .APIKey}} \
{{- else}}
  -e API_KEY="${OPENCTEM_API_KEY:?export OPENCTEM_API_KEY first}" \
{{- end}}
{{- with toolList .Sensor.Tools}}
  -e SENSOR_TOOLS={{.}} \
{{- end}}
{{- if .CACert}}
  -e SSL_CERT_DIR=/etc/openctem/certs \
  -v /etc/openctem/certs:/etc/openctem/certs:ro \
{{- end}}
  -v {{$slug}}-outbox:/var/lib/openctem/outbox \
  {{.Image}}

# Check it: docker logs -f {{$slug}}   (the Sensors page shows it online
# within a minute)
{{- else}}

# {{if .CACert}}2. {{end}}Run one scan of the current directory and send the results (CI or a
# shell). Arguments after the image replace the default command.
docker run --rm \
  -e API_URL={{shellQuote .BaseURL}} \
{{- if .APIKey}}
  -e API_KEY={{shellQuote .APIKey}} \
{{- else}}
  -e API_KEY="${OPENCTEM_API_KEY:?export OPENCTEM_API_KEY first}" \
{{- end}}
{{- if .CACert}}
  -e SSL_CERT_DIR=/etc/openctem/certs \
  -v /etc/openctem/certs:/etc/openctem/certs:ro \
{{- end}}
  -v "$PWD":/scan \
  {{.Image}} \
  -tool {{firstTool .Sensor.Tools}} -target /scan -push
{{- end}}
