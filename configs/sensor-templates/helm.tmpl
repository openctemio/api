{{- $slug := slugify .Sensor.Name -}}
# OpenCTEM sensor "{{$slug}}": Helm (the sensor bundled with the openctem chart)
# Generated by OpenCTEM at {{.GeneratedAt}}. Edit
# configs/sensor-templates/helm.tmpl on the API host to change it.
#
# Runs the sensor next to the platform, in the same cluster and namespace as
# the openctem release, talking to the API service directly. For a sensor in
# another network, use the Kubernetes or docker run instructions instead.
{{- if not (isDaemon .Sensor)}}
#
# The bundled sensor is a long-running one. This sensor runs one scan at a
# time (CI), so use the docker run or Kubernetes Job instructions instead.
{{- else}}
{{- if not .APIKey}}
# The key is shown once, when the sensor is created or its key is rotated:
#   export OPENCTEM_API_KEY='rda_...'
{{- end}}

# 1. Store the sensor's API key in a Secret (never in Helm values).
kubectl create secret generic {{$slug}}-key \
{{- if .APIKey}}
  --from-literal=api-key={{shellQuote .APIKey}}
{{- else}}
  --from-literal=api-key="${OPENCTEM_API_KEY:?export OPENCTEM_API_KEY first}"
{{- end}}

# 2. Turn the bundled sensor on (release "openctem"; use yours).
helm upgrade openctem openctem/openctem --reuse-values \
  --set sensor.enabled=true \
  --set sensor.mode=daemon \
  --set sensor.image.tag={{imageTag .Image}} \
  --set sensor.existingSecret={{$slug}}-key \
{{- with toolList .Sensor.Tools}}
  --set-string 'sensor.tools={{replaceComma .}}' \
{{- end}}
  --set sensor.outbox.persistence.enabled=true
{{- end}}
