# Sensor configuration for {{.Sensor.Name}}
# Generated by OpenCTEM at {{.GeneratedAt}}
#
# Save as agent.yaml: the sensor binary reads the "agent:" section and
# agent_id below by those names.
#
# To customize this template, edit configs/sensor-templates/yaml.tmpl on the
# API host (/app/configs/sensor-templates/yaml.tmpl in the container image, or
# the directory set by SENSOR_CONFIG_TEMPLATES_DIR) — no frontend rebuild needed.

agent:
  name: {{.Sensor.Name}}
  region: "{{.Sensor.Region}}"  # Optional: deployment region for monitoring
  enable_commands: true
  command_poll_interval: 30s
  heartbeat_interval: 1m

server:
  base_url: {{.BaseURL}}
  api_key: {{.APIKey}}
  agent_id: {{.Sensor.ID}}

scanners:
{{- if .Sensor.Tools}}
{{- range .Sensor.Tools}}
  - name: {{toScannerName .}}
    enabled: true
{{- end}}
{{- else}}
  - name: semgrep
    enabled: true
{{- end}}

# Optional: Default scan targets (for standalone mode)
# targets:
#   - /path/to/project1
#   - /path/to/project2
