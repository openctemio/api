{
  "tool": "betterleaks",
  "asset": {"type": "repository", "value": "github.com/acme/infra"},
  "cases": [
    {
      "name": "the secret moved down the file",
      "expect": "same",
      "before": {"type": "secret", "title": "AWS access key", "severity": "critical", "rule_id": "aws-access-token",
        "fingerprint": "config/app.env:aws-access-token:3",
        "location": {"path": "config/app.env", "start_line": 3},
        "secret": {"secret_type": "aws_access_key", "masked_value": "AKIAFAKEFAKEFAKE7Q2X"}},
      "after": {"type": "secret", "title": "AWS access key", "severity": "critical", "rule_id": "aws-access-token",
        "fingerprint": "config/app.env:aws-access-token:9",
        "location": {"path": "config/app.env", "start_line": 9},
        "secret": {"secret_type": "aws_access_key", "masked_value": "AKIAFAKEFAKEFAKE7Q2X"}}
    },
    {
      "name": "two secrets that mask alike are two findings",
      "expect": "different",
      "before": {"type": "secret", "title": "token", "severity": "high", "rule_id": "generic-api-key",
        "location": {"path": "config/app.env", "start_line": 3},
        "secret": {"masked_value": "fake-AAAA1111BBBB-tail"}},
      "after": {"type": "secret", "title": "token", "severity": "high", "rule_id": "generic-api-key",
        "location": {"path": "config/app.env", "start_line": 3},
        "secret": {"masked_value": "fake-CCCC2222DDDD-tail"}}
    },
    {
      "name": "the same secret in another file",
      "expect": "different",
      "before": {"type": "secret", "title": "token", "severity": "high", "rule_id": "generic-api-key",
        "location": {"path": "config/app.env", "start_line": 3},
        "secret": {"masked_value": "fake-AAAA1111BBBB-tail"}},
      "after": {"type": "secret", "title": "token", "severity": "high", "rule_id": "generic-api-key",
        "location": {"path": "deploy/app.env", "start_line": 3},
        "secret": {"masked_value": "fake-AAAA1111BBBB-tail"}}
    }
  ]
}
