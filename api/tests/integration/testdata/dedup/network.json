      "expect": "same",
      "before": {"type": "vulnerability", "title": "SSL Certificate Cannot Be Trusted", "severity": "medium", "rule_id": "51192",
        "network": {"port": 443, "protocol": "tcp"}},
      "after": {"type": "vulnerability", "title": "SSL certificate is not trusted", "severity": "medium", "rule_id": "51192",
        "network": {"port": 443, "protocol": "tcp"}}
