{{- $slug := slugify .Sensor.Name -}}
# OpenCTEM sensor "{{$slug}}": Kubernetes manifests
# Generated by OpenCTEM at {{.GeneratedAt}}. Edit
# configs/sensor-templates/kubernetes.tmpl on the API host to change it.
#
# Apply in the namespace the sensor should run in:
#   kubectl apply -n <namespace> -f {{$slug}}.yaml
{{- if not .APIKey}}
# Replace octs_... below with the sensor's API key first (it is shown once,
# when the sensor is created or its key is rotated).
{{- end}}
apiVersion: v1
kind: Secret
metadata:
  name: {{$slug}}
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
type: Opaque
stringData:
  api-key: {{if .APIKey}}{{.APIKey}}{{else}}octs_...{{end}}
{{- if .CACert}}
  ca.crt: |
{{indent 4 .CACert}}
{{- end}}
{{- if isDaemon .Sensor}}
---
# Results that cannot be delivered yet; a restart or an outage loses nothing.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{$slug}}-outbox
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 2Gi
---
# The sensor's state, including the API key it renews on its own (the Secret
# above keeps the key it was installed with, which a renewal retires).
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{$slug}}-state
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 64Mi
---
# Scanner content cache (trivy DB, nuclei templates, semgrep rules), so a new
# pod does not download it again. Disposable: it can be deleted.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{$slug}}-content
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 5Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{$slug}}
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
spec:
  # One sensor identity (one key) and one outbox: a single replica, and the
  # old pod stops before the new one starts.
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{$slug}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: openctem-sensor
        app.kubernetes.io/instance: {{$slug}}
    spec:
      securityContext:
        # The image runs as uid/gid 999; this lets it write its volumes.
        fsGroup: 999
      containers:
        - name: sensor
          image: {{.Image}}
          env:
            - name: API_URL
              value: {{yamlQuote .BaseURL}}
            - name: API_KEY
              valueFrom:
                secretKeyRef:
                  name: {{$slug}}
                  key: api-key
{{- with toolList .Sensor.Tools}}
            - name: SENSOR_TOOLS
              value: {{yamlQuote .}}
{{- end}}
{{- if .CACert}}
            - name: SSL_CERT_DIR
              value: /etc/openctem/certs
{{- end}}
          volumeMounts:
            - name: outbox
              mountPath: /var/lib/openctem/outbox
            - name: state
              mountPath: /var/lib/openctem/state
            - name: content
              mountPath: /var/lib/openctem/content
{{- if .CACert}}
            - name: ca
              mountPath: /etc/openctem/certs
              readOnly: true
{{- end}}
      volumes:
        - name: outbox
          persistentVolumeClaim:
            claimName: {{$slug}}-outbox
        - name: state
          persistentVolumeClaim:
            claimName: {{$slug}}-state
        - name: content
          persistentVolumeClaim:
            claimName: {{$slug}}-content
{{- if .CACert}}
        - name: ca
          secret:
            secretName: {{$slug}}
            items:
              - key: ca.crt
                path: openctem-root-ca.crt
{{- end}}
{{- else}}
---
# A one-shot sensor: one scan, then the Job completes. Mount what it should
# scan at /scan (the emptyDir below is a placeholder).
apiVersion: batch/v1
kind: Job
metadata:
  name: {{$slug}}-scan
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: openctem-sensor
        app.kubernetes.io/instance: {{$slug}}
    spec:
      restartPolicy: Never
      containers:
        - name: sensor
          image: {{.Image}}
          args: ["-tool", "{{firstTool .Sensor.Tools}}", "-target", "/scan", "-push"]
          env:
            - name: API_URL
              value: {{yamlQuote .BaseURL}}
            - name: API_KEY
              valueFrom:
                secretKeyRef:
                  name: {{$slug}}
                  key: api-key
{{- if .CACert}}
            - name: SSL_CERT_DIR
              value: /etc/openctem/certs
{{- end}}
          volumeMounts:
            - name: scan
              mountPath: /scan
{{- if .CACert}}
            - name: ca
              mountPath: /etc/openctem/certs
              readOnly: true
{{- end}}
      volumes:
        - name: scan
          emptyDir: {}
{{- if .CACert}}
        - name: ca
          secret:
            secretName: {{$slug}}
            items:
              - key: ca.crt
                path: openctem-root-ca.crt
{{- end}}
{{- end}}
