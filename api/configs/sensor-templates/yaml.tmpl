# Sensor configuration for {{slugify .Sensor.Name}}
# Generated by OpenCTEM at {{.GeneratedAt}}
#
# Save as sensor.yaml and run: openctemio-sensor -daemon -config sensor.yaml
# Environment variables (API_URL, API_KEY, SENSOR_TOOLS) override it.
#
# To customize this template, edit configs/sensor-templates/yaml.tmpl on the
# API host (/app/configs/sensor-templates/yaml.tmpl in the container image, or
# the directory set by SENSOR_CONFIG_TEMPLATES_DIR) — no frontend rebuild needed.

sensor:
  name: {{yamlQuote .Sensor.Name}}
  enable_commands: true
  heartbeat_interval: 30s

server:
  base_url: {{yamlQuote .BaseURL}}
  api_key: {{if .APIKey}}{{yamlQuote .APIKey}}{{else}}${API_KEY}{{end}}
  sensor_id: {{.Sensor.ID}}

# Results not yet accepted by the platform wait here; keep it on persistent
# storage so a restart or an outage loses nothing.
outbox:
  dir: /var/lib/openctem/outbox

# The sensor keeps its state, including the API key it renews on its own, in
# SENSOR_STATE_DIR (default /var/lib/openctem/state, else ~/.openctem). Keep
# that directory: without it the sensor starts with api_key above, which a
# renewal has retired.

scanners:
{{- with tools .Sensor.Tools}}
{{- range .}}
  - name: {{toScannerName .}}
    enabled: true
{{- end}}
{{- else}}
  - name: semgrep
    enabled: true
{{- end}}
