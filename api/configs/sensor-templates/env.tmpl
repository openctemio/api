# Environment variables for {{slugify .Sensor.Name}}
# Generated by OpenCTEM at {{.GeneratedAt}}
{{- if .APIKey}}
export API_URL={{shellQuote .BaseURL}}
export API_KEY={{shellQuote .APIKey}}
{{- else}}
# The API key is shown once, when the sensor is created or its key is rotated.
export API_URL={{shellQuote .BaseURL}}
export API_KEY='rda_...'
{{- end}}
{{- with toolList .Sensor.Tools}}
export SENSOR_TOOLS={{.}}
{{- end}}
{{- if .CACert}}
# The platform uses a private CA: install it (see the docker run instructions)
# and let the sensor trust it alongside the system roots.
export SSL_CERT_DIR=/etc/openctem/certs
{{- end}}
