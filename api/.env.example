# =============================================================================
# Development Environment Configuration
# =============================================================================
# Copy this to .env for local development

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=openctem
APP_ENV=development
APP_DEBUG=true
# Public origin of this API (scheme://host[:port]). SAML SP entity ID / ACS URL
# are built from it; when unset they fall back to the request Host, and
# X-Forwarded-* is honored only from SERVER_TRUSTED_PROXIES.
APP_URL=http://localhost:8080

APP_ENCRYPTION_KEY="openssl rand -hex 32"
# Only while rotating APP_ENCRYPTION_KEY: the old key(s), comma-separated.
# Values encrypted under them stay readable and tokens hashed with them keep
# verifying until cmd/rekey has run and the tokens are re-issued. See
# docs/deployment/encryption-key-rotation.md.
# APP_ENCRYPTION_KEY_PREVIOUS=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_REQUEST_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=30s
SERVER_MAX_BODY_SIZE=1048576

# gRPC (optional)
#GRPC_PORT=9090

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=openctem
DB_PASSWORD=secret
DB_NAME=openctem
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
# PostgreSQL JIT for API sessions. Off by default: request-path queries pay
# the JIT compile (hundreds of ms) without benefiting from it.
DB_JIT_ENABLED=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
# TLS Settings (disabled in development)
REDIS_TLS_ENABLED=false
REDIS_TLS_SKIP_VERIFY=false
# Retry Settings
REDIS_MAX_RETRIES=3
REDIS_MIN_RETRY_DELAY=100ms
REDIS_MAX_RETRY_DELAY=3s

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json

# Log Sampling (for production - reduces log volume)
# See docs/development/logging.md for details
LOG_SAMPLING_ENABLED=false       # Enable in production
LOG_SAMPLING_THRESHOLD=100       # First N identical logs per second
LOG_SAMPLING_RATE=0.1            # Sample rate after threshold (10%)
LOG_ERROR_SAMPLING_RATE=1.0      # Always log errors (100%)
LOG_SKIP_HEALTH=true             # Skip health check endpoints
LOG_SLOW_REQUEST_SECONDS=5       # Warn on slow requests

# -----------------------------------------------------------------------------
# Keycloak Authentication (only needed if AUTH_PROVIDER is "oidc" or "hybrid")
# -----------------------------------------------------------------------------
# Local Keycloak for development (use port 8180 to avoid conflict with backend)
#KEYCLOAK_BASE_URL=http://localhost:8180
#KEYCLOAK_REALM=openctem
#KEYCLOAK_CLIENT_ID=api
#KEYCLOAK_JWKS_REFRESH_INTERVAL=1h
#KEYCLOAK_HTTP_TIMEOUT=10s

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# F-12: Explicit dev origin. Wildcard '*' is rejected at startup in production.
# For multi-origin dev, use comma-separated: CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Request-ID
CORS_MAX_AGE=86400

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
RATE_LIMIT_CLEANUP=1m
# Per-user budget for authenticated GET requests (also the burst). Raise it
# for heavy dashboard users behind one account; <= 0 keeps the default.
RATE_LIMIT_READ_PER_MIN=120

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Auth provider: "local" | "oidc" | "hybrid"
AUTH_PROVIDER=local

# JWT Configuration (required for local/hybrid auth)
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=your-super-secret-key-at-least-64-characters-long-for-production
AUTH_JWT_ISSUER=api
AUTH_ACCESS_TOKEN_DURATION=15m
AUTH_REFRESH_TOKEN_DURATION=168h
AUTH_SESSION_DURATION=720h

# Password Policy
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_NUMBER=true
AUTH_PASSWORD_REQUIRE_SPECIAL=false

# Security Settings
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m
AUTH_MAX_ACTIVE_SESSIONS=10
# Self-registration (default false). Accounts are created by an administrator
# (Settings > Users > Add user, or the admin console), by accepting an
# invitation (works with this off), or by the organization's SSO. Set true only
# for an open trial instance.
AUTH_ALLOW_REGISTRATION=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Secure flag on session cookies. Defaults to true unless APP_ENV=development
# (plain http://localhost). Set true when serving over HTTPS.
AUTH_COOKIE_SECURE=false

# Platform administrators (who configure organization SSO, create
# organizations, etc.) are no longer set here: PLATFORM_ADMIN_EMAILS was
# removed. Create the first one with `bootstrap-admin -email=...`; it signs in
# on the normal /login page and opens the admin console with a TOTP code. See
# docs/rfcs/RFC-022-platform-admin-console.md.

# Who can create organizations (tenants):
#   admin_only (default): only the platform administrator, from the admin
#               console (POST /api/v1/admin/tenants) or at first install with
#               bootstrap-admin -org-name/-org-owner-email. On-prem/enterprise.
#   self_service: any signed-in user (create-first-team, POST /api/v1/tenants),
#               e.g. SaaS or trial installs. An explicit opt-in.
# An invalid value fails startup.
#TENANT_CREATION_MODE=admin_only
#AUTH_EMAIL_VERIFICATION_DURATION=24h
#AUTH_PASSWORD_RESET_DURATION=1h

# -----------------------------------------------------------------------------
# SMTP Email Configuration
# -----------------------------------------------------------------------------
SMTP_ENABLED=false
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=noreply@example.com
#SMTP_PASSWORD=your-smtp-password
#SMTP_FROM=noreply@example.com
#SMTP_FROM_NAME=OpenCTEM
#SMTP_TLS=true
#SMTP_SKIP_VERIFY=false
#SMTP_BASE_URL=http://localhost:3000
#SMTP_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Connectors (Optional)
# -----------------------------------------------------------------------------
# Wiz Integration
#WIZ_CLIENT_ID=
#WIZ_CLIENT_SECRET=
#WIZ_AUTH_URL=
#WIZ_API_URL=

# Tenable Integration
#TENABLE_ACCESS_KEY=
#TENABLE_SECRET_KEY=

# -----------------------------------------------------------------------------
# OAuth / Social Login Configuration
# -----------------------------------------------------------------------------
# Enable OAuth globally
OAUTH_ENABLED=false

# Frontend callback URL for OAuth redirects
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback

# State secret for CSRF protection (generate with: openssl rand -base64 48)
OAUTH_STATE_SECRET=

# State token expiration
OAUTH_STATE_DURATION=10m

# Google OAuth
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_SCOPES=openid,email,profile

# GitHub OAuth
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_SCOPES=read:user,user:email

# Microsoft OAuth (Entra ID / Azure AD)
OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_SCOPES=openid,email,profile,User.Read
OAUTH_MICROSOFT_TENANT=common

# -----------------------------------------------------------------------------
# AI Triage Configuration
# -----------------------------------------------------------------------------
# AI-powered vulnerability triage is automatically enabled when:
# 1. At least one LLM API key is configured below (Anthropic, OpenAI, or Gemini)
# 2. The 'ai_triage' module is active in the database (modules.is_active = true)
# 3. Tenant's plan includes the 'ai_triage' module
#
# DEPRECATED: AI_TRIAGE_ENABLED is no longer used - feature availability is
# controlled by module is_active in database. This variable is ignored.
# AI_TRIAGE_ENABLED=false

# Platform LLM Provider: "claude" | "openai" | "gemini"
AI_PLATFORM_PROVIDER=claude

# Model to use for AI triage
# Claude: claude-sonnet-4-20250514, claude-opus-4-20250514
# OpenAI: gpt-4o, gpt-4-turbo
# Gemini: gemini-2.0-flash, gemini-1.5-pro
AI_PLATFORM_MODEL=claude-sonnet-4-20250514

# LLM API Keys (only need one based on AI_PLATFORM_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Processing Limits
AI_MAX_CONCURRENT_JOBS=10
# Caps LLM completions per minute, enforced in front of every provider call.
# A call over the cap waits for a token and fails with a rate-limit error if
# none arrives within 30s. The allowance is shared by everything spending the
# same API key: platform-mode tenants share the platform key's budget, each
# BYOK tenant gets its own. 0 or negative disables the cap.
AI_RATE_LIMIT_RPM=60
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2000

# LLM Parameters
# Temperature controls randomness (0.0 = deterministic, 1.0 = creative)
# Lower values produce more consistent results for security analysis
AI_TEMPERATURE=0.1

# Auto-Triage Settings (triggered automatically on new findings)
# These are PLATFORM defaults: they apply to tenants that have not set the
# corresponding key in their own AI settings. A tenant's explicit choice
# (including an explicit "off") always wins.
AI_AUTO_TRIAGE_DEFAULT_ENABLED=false
AI_AUTO_TRIAGE_DEFAULT_SEVERITIES=critical,high
AI_AUTO_TRIAGE_DELAY=60s

# =============================================================================
# Metrics / Observability
# =============================================================================
# The Prometheus /metrics endpoint is NOT public by default (it leaks internal
# route/cardinality info). Choose ONE of:
#   1. Set METRICS_TOKEN and configure your scraper with a matching bearer token
#      (Authorization: Bearer <token>, or the X-Metrics-Token header).
#   2. Set METRICS_PUBLIC=true ONLY when /metrics is firewalled to an internal
#      scrape network.
# If METRICS_PUBLIC=false and METRICS_TOKEN is empty, /metrics returns 404.
# /health and /ready are always public.
METRICS_PUBLIC=false
METRICS_TOKEN=

# =============================================================================
# Sensor Load Balancing
# =============================================================================
# Weights for the sensor load score (lower score = better job placement target).
# score = job*job_load% + cpu*cpu% + mem*mem% + disk*disk_io% + net*net_io%
# They should sum to 1.0. The score is recomputed on every sensor heartbeat AND
# used by the scheduler to pick a sensor, so changing these changes placement.
# Sensors that do not report disk/network throughput leave those terms at 0.
# (Formerly AGENT_LB_*; the old names still work with a startup warning.)
SENSOR_LB_JOB_WEIGHT=0.30
SENSOR_LB_CPU_WEIGHT=0.40
SENSOR_LB_MEMORY_WEIGHT=0.15
SENSOR_LB_DISK_IO_WEIGHT=0.10
SENSOR_LB_NETWORK_WEIGHT=0.05
# Throughput that normalises to 100% load for the disk/network terms.
SENSOR_LB_MAX_DISK_THROUGHPUT_MBPS=500
SENSOR_LB_MAX_NETWORK_THROUGHPUT_MBPS=1000

# Heartbeat doorbell (RFC-023 §9.2a): the interval the heartbeat response
# advises in next_heartbeat_seconds. Clamped to [MIN, MAX], and MAX to half of
# WORKER_HEARTBEAT_TIMEOUT so a sensor following the advice never goes offline.
# SENSOR_HEARTBEAT_INTERVAL=30s
# SENSOR_HEARTBEAT_BUSY_INTERVAL=5s
# SENSOR_HEARTBEAT_LOADED_INTERVAL=2m
# SENSOR_HEARTBEAT_MIN_INTERVAL=5s
# SENSOR_HEARTBEAT_MAX_INTERVAL=5m
# Doorbell query latency that counts as "platform under load".
# SENSOR_HEARTBEAT_SLOW_QUERY=250ms
# How long a renewed sensor API key stays valid (default 2160h = 90 days; 0 =
# renewed keys never expire). Sensors renew on their own (SDK v0.12+, when
# their state volume persists); keys created or regenerated by an
# administrator never expire, and a sensor that does not renew keeps its key.
# SENSOR_KEY_TTL=2160h
# Ring rotate_key this long before the presented key expires (default: half of
# SENSOR_KEY_TTL, or 24h).
# SENSOR_KEY_RENEW_BEFORE=
# Secret the sensor API-key hash (HMAC-SHA256) is keyed with. Default: derived
# from APP_ENCRYPTION_KEY with HKDF (a different key from the encryption key).
# Keys stored under the old pepper (APP_ENCRYPTION_KEY itself, before RFC-032
# Phase 0) keep working. At least 32 characters: openssl rand -hex 32.
# SENSOR_KEY_PEPPER=
# When replacing SENSOR_KEY_PEPPER, list the old value(s) here (comma-separated)
# so keys stored under them keep working until they are renewed.
# SENSOR_KEY_PEPPER_PREVIOUS=

# Sensor release channel (Sensors page). Each sensor's version is compared with
# it: "update available" below LATEST, degraded + "unsupported" below MIN. The
# install snippets pin the sensor image to LATEST. Defaults come from
# versions.yaml at the repository root (RFC-037): LATEST as shown below, MIN
# none (v0.4.0 below is an example). "none" turns a setting off.
# SENSOR_LATEST_VERSION=v0.6.4
# SENSOR_MIN_VERSION=v0.4.0
# SDK policy: the SDK each sensor is built with (heartbeat "sdk" member, or its
# User-Agent). Below MIN: degraded + "SDK below minimum"; below LATEST: "outdated".
# Defaults from versions.yaml: LATEST as shown below, MIN none (v0.8.0 below is
# an example).
# SENSOR_SDK_MIN_VERSION=v0.8.0
# SENSOR_SDK_LATEST_VERSION=v0.14.0
# Sensor image the install snippets run (tag = SENSOR_LATEST_VERSION).
# SENSOR_IMAGE=ghcr.io/openctemio/sensor
# The platform's private CA, installed by the snippets on the sensor host. With
# the built-in gateway in TLS mode internal, mount its CA export directory into
# the API read-only and point this at the exported root.
# SENSOR_CA_CERT_FILE=/ca/openctem-root-ca.crt

# =============================================================================
# Admin Audit Log Retention
# =============================================================================
# Prunes the platform-level admin_audit_logs table. DRY_RUN defaults to true:
# the controller reports how many rows it WOULD delete and deletes nothing, so
# an upgrade never silently destroys audit history. Review the
# "dry run - would delete audit logs" WARN entries, then set DRY_RUN=false to
# enforce retention. Deletion is irreversible — back up first.
ADMIN_AUDIT_RETENTION_ENABLED=true
ADMIN_AUDIT_RETENTION_DRY_RUN=true
# Must be >= 30 when DRY_RUN=false; the server refuses to boot otherwise.
# SOC 2 / PCI DSS expect at least 365 days.
ADMIN_AUDIT_RETENTION_DAYS=365
ADMIN_AUDIT_RETENTION_INTERVAL=24h
ADMIN_AUDIT_RETENTION_BATCH_SIZE=10000

# -----------------------------------------------------------------------------
# Attachment storage (server-wide; tenants may add their own bucket in settings)
# -----------------------------------------------------------------------------
# local (default): files under STORAGE_LOCAL_PATH; mount a volume there.
# s3 | minio: an S3-compatible bucket. Needed when several API replicas serve
# attachments without a shared (ReadWriteMany) volume. Switching provider later
# does not move existing files.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/attachments
# STORAGE_BUCKET=
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=          # empty = AWS S3; e.g. http://minio:9000
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
