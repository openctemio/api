# OpenCTEM production stack (deploy/docker-compose.yml). Copy to .env.

# --- Version -----------------------------------------------------------------
OPENCTEM_VERSION=v0.8.0

# --- How clients reach OpenCTEM (one HTTPS port) -----------------------------
# The DNS name or IP address browsers and sensors use.
OPENCTEM_HOSTNAME=ctem.example.com
# The exact origin browsers see. Add the port when it is not 443,
# e.g. https://192.168.1.10:8443 with GATEWAY_HTTPS_PORT=8443.
OPENCTEM_PUBLIC_URL=https://ctem.example.com
# Published HTTPS port and interface.
GATEWAY_HTTPS_PORT=443
GATEWAY_BIND=0.0.0.0

# --- TLS ---------------------------------------------------------------------
#   internal  gateway's own CA (LAN / IP installs). Root CA for sensors is
#             exported to ./ca/openctem-root-ca.crt
#   acme      Let's Encrypt for a public DNS name (needs ACME_EMAIL; port 443
#             reachable from the internet)
#   files     your certificate: ./certs/tls.crt (full chain) + ./certs/tls.key
#   http      plain HTTP behind your own TLS proxy (docker-compose.plain-http.yml,
#             OPENCTEM_ALLOW_PLAIN_HTTP=true)
OPENCTEM_TLS_MODE=internal
ACME_EMAIL=
# TLS_CERT_DIR=./certs
# TLS_CERT_FILE=tls.crt
# TLS_KEY_FILE=tls.key
# OPENCTEM_ALLOW_PLAIN_HTTP=false
# Proxies/load balancers in front of the gateway whose X-Forwarded-For is
# believed (space-separated CIDRs). Leave empty when clients connect directly.
# OPENCTEM_TRUSTED_PROXIES=

# --- Internal network --------------------------------------------------------
# /24 used inside the stack; change if it overlaps a network on this host.
# OPENCTEM_NET_PREFIX=172.30.80

# --- Secrets (generate each one) ----------------------------------------------
DB_PASSWORD=          # openssl rand -hex 24
REDIS_PASSWORD=       # openssl rand -hex 24
AUTH_JWT_SECRET=      # openssl rand -hex 64
APP_ENCRYPTION_KEY=   # openssl rand -hex 32
CSRF_SECRET=          # openssl rand -hex 32
