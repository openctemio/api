# =============================================================================
# Dockerfile for Database Migrations
# =============================================================================
# Lightweight image containing only migration files and the migrate tool.
# Used by docker-compose to run database migrations independently.
#
# Build:
#   docker build -f Dockerfile.migrations -t ghcr.io/openctemio/migrations:v0.1.0 .
#
# Usage:
#   docker run --rm ghcr.io/openctemio/migrations:v0.1.0 \
#     -path=/migrations \
#     -database "postgres://user:pass@host:5432/db?sslmode=disable" \
#     up
#
# Commands:
#   up     - Apply all pending migrations
#   down   - Rollback last migration
#   drop   - Drop all tables
#   force N - Set version to N without running migration
#   version - Show current version
#
# checkov:skip=CKV_DOCKER_2: One-time migration container, no healthcheck needed
# =============================================================================

# golang-migrate is compiled here from its tagged module, the same way and the
# same version as CI (api-ci.yml) and the all-in-one image
# (deploy/allinone/Dockerfile). It used to be a release tarball downloaded with
# wget and no checksum (v4.17.0, built with a Go toolchain from 2023 whose
# standard library has since had many CVEs); `go install` verifies every module
# against go.sum / the checksum database and uses the pinned Go below. Built in
# the target platform's own stage, so there is no arch-specific URL to get wrong.
FROM golang:1.26.8-alpine AS migrate
RUN CGO_ENABLED=0 go install -trimpath -ldflags="-s -w" -tags postgres \
      github.com/golang-migrate/migrate/v4/cmd/migrate@v4.18.1 \
 && cp "$(go env GOPATH)/bin/migrate" /usr/local/bin/migrate

# Alpine 3.20 reached end of support on 2026-04-01 (no more security fixes).
FROM alpine:3.22

# Install runtime dependencies
RUN apk add --no-cache ca-certificates

COPY --from=migrate /usr/local/bin/migrate /usr/local/bin/migrate

# Copy migration files
COPY migrations /migrations

# The files are only read; the job needs no privileges (uid of the distroless
# "nonroot" user, so Kubernetes runAsNonRoot accepts it).
USER 65532:65532

# Default: show help
ENTRYPOINT ["migrate"]
CMD ["-help"]
