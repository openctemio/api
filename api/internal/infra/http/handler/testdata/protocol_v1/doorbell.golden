# idle, v1 sensor: plain v1 response
POST /api/v1/agent/heartbeat
status: 200
Content-Type: application/json

{"agent_id":"<self>","status":"ok","tenant_id":"<tenant>"}

----
# work waiting, v1 sensor: pending_jobs and the busy interval only
POST /api/v1/agent/heartbeat
status: 200
Content-Type: application/json

{"agent_id":"<self>","status":"ok","tenant_id":"<tenant>","pending_jobs":2,"next_heartbeat_seconds":5}

----
# work waiting, doorbell-aware sensor: plus config_version
POST /api/v1/agent/heartbeat
status: 200
Content-Type: application/json

{"agent_id":"<self>","status":"ok","tenant_id":"<tenant>","pending_jobs":2,"config_version":"<config-version>","next_heartbeat_seconds":5}

----
# poll
GET /api/v1/agent/commands?limit=10
status: 200
Content-Type: application/json

[{"id":"<cmd-pool>","tenant_id":"<tenant>","type":"scan","priority":"normal","payload":{"target":".","scanner":"semgrep"},"status":"pending","created_at":"<time>","expires_at":"<time>"},{"id":"<cmd-pinned>","tenant_id":"<tenant>","agent_id":"<self>","type":"scan","priority":"normal","payload":{"scanner":"semgrep"},"status":"pending","created_at":"<time>"}]

----
# claim the pool command
POST /api/v1/agent/commands/<cmd-pool>/acknowledge
status: 200
Content-Type: application/json

{"id":"<cmd-pool>","tenant_id":"<tenant>","agent_id":"<self>","type":"scan","priority":"normal","payload":{"target":".","scanner":"semgrep"},"status":"acknowledged","created_at":"<time>","expires_at":"<time>","acknowledged_at":"<time>"}

----
# claim the pinned command
POST /api/v1/agent/commands/<cmd-pinned>/acknowledge
status: 200
Content-Type: application/json

{"id":"<cmd-pinned>","tenant_id":"<tenant>","agent_id":"<self>","type":"scan","priority":"normal","payload":{"scanner":"semgrep"},"status":"acknowledged","created_at":"<time>","acknowledged_at":"<time>"}

----
# idle, doorbell-aware sensor: config_version and the idle interval
POST /api/v1/agent/heartbeat
status: 200
Content-Type: application/json

{"agent_id":"<self>","status":"ok","tenant_id":"<tenant>","config_version":"<config-version>","next_heartbeat_seconds":30}

----
# idle again, v1 sensor: plain v1 response
POST /api/v1/agent/heartbeat
status: 200
Content-Type: application/json

{"agent_id":"<self>","status":"ok","tenant_id":"<tenant>"}

----
# disabled, v1 sensor: unchanged v1 401
POST /api/v1/agent/heartbeat
status: 401
Content-Type: application/json

{"error":"UNAUTHORIZED","code":"UNAUTHORIZED","message":"Invalid API key"}

----
# disabled, doorbell-aware sensor: 200 with pause
POST /api/v1/agent/heartbeat
status: 200
Content-Type: application/json

{"agent_id":"<self>","status":"ok","tenant_id":"<tenant>","actions":["pause"],"next_heartbeat_seconds":30}

----
# disabled, doorbell-aware sensor, any other route: 401
GET /api/v1/agent/commands
status: 401
Content-Type: application/json

{"error":"UNAUTHORIZED","code":"UNAUTHORIZED","message":"Invalid API key"}

----
# revoked, doorbell-aware sensor: 401
POST /api/v1/agent/heartbeat
status: 401
Content-Type: application/json

{"error":"UNAUTHORIZED","code":"UNAUTHORIZED","message":"Invalid API key"}
